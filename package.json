{
  "name": "cz-todo-list",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:extension": "webpack --config webpack.extension.js --mode production",
    "dev:extension": "webpack watch --config webpack.extension.js --mode development",
    "typecheck:extension": "tsc --project tsconfig.extension.json --noEmit",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "supabase:migrate": "supabase migration up --local",
    "supabase:link": "supabase link"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "@supabase/supabase-js": "^2.115.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next": "14.2.13",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-react": "^5.17.14",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "supabase": "^2.116.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/chrome": "^0.2.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-react": "^4.18.3",
    "autoprefixer": "^10.4.14",
    "css-loader": "^7.1.5",
    "dotenv": "^17.4.2",
    "eslint": "^8.0.0",
    "eslint-config-next": "14.2.13",
    "postcss": "^8.4.24",
    "prisma": "^6.17.0",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.0.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3"
  }
}
