{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["chrome", "node"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "incremental": false,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "include": ["extension/**/*.ts", "extension/**/*.tsx"],
  "exclude": ["node_modules", "extension/dist"]
}
