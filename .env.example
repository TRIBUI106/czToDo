# Environment variables for production deployment

# Database - Replace with your production database URL
# For PostgreSQL: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL="your-production-database-url"

# NextAuth - Replace with your production URL and secret
NEXTAUTH_URL="https://your-app-name.vercel.app"
NEXTAUTH_SECRET="your-production-secret-key-generate-a-random-string"

# Chrome extension build - copy to .env.local and replace both values.
# The extension build rejects missing or placeholder configuration.
REACT_APP_SUPABASE_URL="https://your-project.supabase.co"
REACT_APP_SUPABASE_ANON_KEY="your-anon-key"

# Optional: OAuth providers (can be added later)
# GITHUB_ID="your-github-oauth-app-id"
# GITHUB_SECRET="your-github-oauth-app-secret"
# GOOGLE_ID="your-google-oauth-client-id"
# GOOGLE_SECRET="your-google-oauth-client-secret"